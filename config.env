# KernelSU Action -- build profile (Redmi K40 Pro / haydn, HyperOS)
# 使用方法：GitHub 网页打开你 Fork 的仓库 → config.env → 铅笔编辑 → 全选删除 → 粘贴本文件全部内容 → Commit
CONFIG_ENV=config.env
# ============================================================ Kernel source ==
KERNEL_SOURCE=https://github.com/40120332/android_kernel_xiaomi_sm8350
KERNEL_SOURCE_BRANCH=lineage-24.0
KERNEL_CONFIG=vendor/lahaina-qgki_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
# Optional: overrides the device label used in artifact names and sets
# CONFIG_LOCALVERSION. Leave blank to derive it from KERNEL_CONFIG.
KERNEL_NAME=haydn-hyperos
ADD_LOCALVERSION_TO_FILENAME=false
# Extra flags appended to every make invocation. Values may contain "=".
EXTRA_CMDS=
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-
# =================================================================== Clang ==
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
# Build fully with LLVM (LLVM=1 LLVM_IAS=1). 5.4 树不要开。
USE_LLVM=false
# ===================================================================== GCC ==
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-
# =============================================================== KernelSU ===
KSU_VARIANT=resukisu
KSU_REF=
# auto | kprobes | manual | tracepoint | syscall | none
# 5.4 旧内核用 manual（kprobes 在这类内核上容易"装上但 su 无反应"）
KSU_HOOK_MODE=kprobes
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=
# =================================================================== SUSFS ==
# 若构建因 SUSFS 补丁失败（日志会明确提示），改为 false 重跑即可（隐藏能力降级，root 不受影响）
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto
# ========================================================== Extra patches ==
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false
# ================================================================ Kconfig ==
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=true
# 关键：本树 defconfig 缺显示配置（维护者靠 CAF build.sh 注入），这里补齐，且显示内置（只刷 boot 也能亮屏）
EXTRA_DEFCONFIG=CONFIG_DRM_MSM=y CONFIG_DRM_MSM_SDE=y CONFIG_SYNC_FILE=y CONFIG_DRM_MSM_DSI=y CONFIG_DRM_MSM_DP=y CONFIG_DRM_MSM_DP_MST=y CONFIG_DSI_PARSER=y CONFIG_QCOM_MDSS_PLL=y CONFIG_DRM_SDE_WB=y CONFIG_DRM_MSM_REGISTER_LOGGING=y CONFIG_DRM_SDE_RSC=y CONFIG_DISPLAY_BUILD=y
# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=
# ============================================================== Packaging ===
NEED_DTBO=false
# 用 TWRP 刷 AnyKernel3，不需要 boot.img 重打包
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=
# ================================================================= Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
